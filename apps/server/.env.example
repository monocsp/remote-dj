# Port the HTTP/Socket.IO server listens on
PORT=3001
# Network interface to bind (0.0.0.0 = all interfaces)
HOSTNAME=0.0.0.0
# Allowed CORS origin(s) for Socket.IO ('*' = allow any)
CORS_ORIGIN=*

# OPTIONAL: YouTube Data API v3 key. When set, the server checks
# `status.embeddable` at add time and BLOCKS embed-disabled videos on the FIRST
# add (the only reliable way). Without it, embed-disabled videos are caught at
# playback (the Player reports the error) and then blocked per-room thereafter.
# Get one: Google Cloud Console → enable "YouTube Data API v3" → Credentials →
# create API key (restrict it to YouTube Data API v3).
YOUTUBE_API_KEY=
